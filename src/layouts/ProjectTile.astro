---
const { project, level = "2" } = Astro.props;
const label = `${project.name} - ${project.kind} - ${project.summary}`;
---

<li
  role="listitem"
  class:list={["tile-item", "nr-scroll-animation", "portfolio-tile-item", { "item-2up": level === "2", "item-3up": level === "3" }]}
  style="--nr-animation-transform-y:20%;"
>
  <a
    href={project.href}
    class:list={["tile", "portfolio-news-tile", "large-load", "medium-load", "small-load", { "portfolio-news-tile-large": level === "2" }]}
    aria-label={label}
    target="_blank"
    rel="noreferrer"
  >
    <div class="tile__media portfolio-news-media" aria-hidden="true">
      <img class="cover image" data-src={project.cover} alt="" />
    </div>

    <div class="tile__description portfolio-news-description">
      <div class="tile__head">
        <div class="tile__category">{project.kind}</div>
        <div class="tile__headline">{project.name}</div>
        <p class="portfolio-news-summary">{project.summary}</p>
      </div>
      <div class="portfolio-news-stack" aria-label={`${project.name} stack`}>
        {project.stack.map((item) => <span>{item}</span>)}
      </div>
    </div>
  </a>
</li>
