---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout primaryTitle="About">
  <main class="portfolio-apple">
    <section class="everydayfeed portfolio-page-hero">
      <div class="featured-header with-keyline">
        <div class="pagetitle">
          <div class="component-content">
            <h1 class="hero-headline">About</h1>
          </div>
        </div>
        <p class="featured-subhead">Practical tools around AI workflows, automation, and focused macOS utilities.</p>
        <div class="portfolio-apple-actions">
          <a href="/" class="cta-primary-light">Back home</a>
          <a href="https://github.com/Gitnapp" class="cta-primary-light" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
    </section>

    <section class="more-from-newsroom">
      <div class="section-content">
        <h2 class="section-head">Focus</h2>
        <div class="portfolio-about-grid">
          <article class="portfolio-about-card">
            <h3>Agent workflows</h3>
            <p>Reusable skills, local automation, and small systems that make AI assistants more dependable.</p>
          </article>
          <article class="portfolio-about-card">
            <h3>macOS utilities</h3>
            <p>Focused native tools for everyday interface friction, built with the calmness of system software.</p>
          </article>
          <article class="portfolio-about-card">
            <h3>Developer tools</h3>
            <p>Compact web and command-line tools that turn repeated manual work into repeatable routines.</p>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
