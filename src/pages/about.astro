---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout primaryTitle="About">
  <main class="portfolio">
    <section class="portfolio-page-head">
      <div class="portfolio-shell">
        <a class="back-link" href="/">Back to home</a>
        <h1>About</h1>
        <p>
          I am Eric Yu, a developer building practical tools around AI workflows, automation, and focused macOS utilities.
        </p>
      </div>
    </section>

    <section class="portfolio-section portfolio-split">
      <div class="portfolio-shell split-grid">
        <div>
          <h2>Focus</h2>
          <p>
            My work sits around small, useful systems: agent workflows, local-first automation, developer tooling, and software that turns repeated manual steps into dependable routines.
          </p>
        </div>
        <div class="about-panel">
          <h3>Links</h3>
          <a href="https://github.com/Gitnapp" target="_blank" rel="noreferrer">GitHub</a>
          <a href="/projects">Projects</a>
          <a href="/archive">Writing archive</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
