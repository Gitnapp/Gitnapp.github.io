---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout bare bodyClass="page-quiet">
  <main class="quiet-home" aria-label="Eric Yu">
    <header class="quiet-top">
      <a class="quiet-name" href="/" aria-current="page">Eric Yu</a>
      <p>Builder</p>
    </header>

    <h1 class="quiet-statement">I make tools that ask for less attention.</h1>

    <footer class="quiet-bottom">
      <p>AI agents. macOS. Automation.</p>
      <nav class="quiet-links" aria-label="Links">
        <a href="/projects">Selected work</a>
        <a href="/archive">Notes</a>
        <a href="https://github.com/Gitnapp" target="_blank" rel="noreferrer">Contact</a>
      </nav>
    </footer>
  </main>
</BaseLayout>
